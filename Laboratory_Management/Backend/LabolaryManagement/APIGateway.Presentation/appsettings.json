{
  "ReverseProxy": {
    "Routes": {
      "iam-api": {
        "ClusterId": "iam-rest",
        "Match": { "Path": "/iam/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/iam" } ]
      },
      "iam-grpc": {
        "ClusterId": "iam-grpc",
        "Match": { "Path": "/iam.UserService/{**catch-all}" }
      },
      "patient-api": {
        "ClusterId": "patient-cluster",
        "Match": { "Path": "/patient/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/patient" } ]
      }
    },
    "Clusters": {
      "iam-rest": {
        "Destinations": { "iam": { "Address": "http://iam.api:5001/" } },
        "HttpRequest": { "Version": "1.1" }
      },
      "iam-grpc": {
        "Destinations": { "iam": { "Address": "http://iam.api:5001/" } },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrHigher"
        }
      },
      "patient-cluster": {
        "Destinations": { "patient": { "Address": "http://patient.api:5002/" } }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    },
    "EndpointDefaults": { "Protocols": "Http1AndHttp2" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
