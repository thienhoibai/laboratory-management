{
  "ReverseProxy": {
    "Routes": {
      "iam-api": {
        "ClusterId": "iam-rest",
        "Match": { "Path": "/iam/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/iam" }]
      },
      "iam-grpc": {
        "ClusterId": "iam-grpc",
        "Match": { "Path": "/iam.UserService/{**catch-all}" }
      },
      "patient-api": {
        "ClusterId": "patient-cluster",
        "Match": { "Path": "/patient/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/patient" }]
      },
      "testorder-api": {
        "ClusterId": "testorder-cluster",
        "Match": { "Path": "/testorder/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/testorder" } ]
      },
      "blog-api": {
        "ClusterId": "blog-cluster",
        "Match": { "Path": "/blog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/blog" } ]
      }
    },

    "Clusters": {
      "iam-rest": {
        "Destinations": { "iam": { "Address": "http://iam.api:5001/" } },
        "HttpRequest": { "Version": "1.1" }
      },
      "iam-grpc": {
        "Destinations": { "iam": { "Address": "http://iam.api:5001/" } },
        "HttpRequest": {
          "Version": "2.0",
          "VersionPolicy": "RequestVersionOrHigher"
        }
      },
      "patient-cluster": {
        "Destinations": { "patient": { "Address": "http://patient.api:5002/" } }
      },
      "testorder-cluster": {
        "Destinations": {
          "testorder": { "Address": "http://testorder.api:5003/" }
        },
        "HttpRequest": { "Version": "1.1" }
      },
      "blog-cluster": {
        "Destinations": {
          "blog": { "Address": "http://blogservice.api:5004/" }
        },
        "HttpRequest": { "Version": "1.1" }
      },
      "blog-cluster": {
        "Destinations": { "blog": { "Address": "http://blogservice.api:5004/" } },
        "HttpRequest": { "Version": "1.1" }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    },
    "EndpointDefaults": { "Protocols": "Http1AndHttp2" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
